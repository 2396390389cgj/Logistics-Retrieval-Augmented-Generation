# ============ LLM ============
# 配置后走 OpenAI 兼容接口生成答案；不配置则使用内置抽取式兜底生成器
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============ Embedding / Reranker ============
# 本地有 GPU/已下载模型时开启；否则使用离线 Hash 向量回退
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
USE_LOCAL_EMBEDDING=false

# ============ 存储 ============
# MySQL（不配置则降级 SQLite data/app.db）
MYSQL_URL=mysql+pymysql://root:root@127.0.0.1:3306/logistics_rag?charset=utf8mb4
# Redis（不配置则降级内存缓存）
REDIS_URL=redis://127.0.0.1:6379/0
# Elasticsearch（不配置则降级内置 BM25 内存索引）
ES_URL=http://127.0.0.1:9200
ES_INDEX=logistics_rag_chunks

# ============ TMS / OMS ============
TMS_BASE_URL=http://mock-tms:8001
OMS_BASE_URL=http://mock-oms:8002
# 为空时使用内置 Mock 运单数据

# ============ 检索参数 ============
BM25_TOPK=50
VECTOR_TOPK=50
RRF_K=60
RERANK_TOPK=6
TIME_DECAY_HALFLIFE_DAYS=180
